# Plantilla de configuracion. Copia este archivo a ".env" y completa los valores.
# ".env" esta en .gitignore: NUNCA subas tu clave real a Git.

# API key de EIA (registrala en https://www.eia.gov/opendata/register.php)
EIA_API_KEY=

# Opcionales (valores por defecto entre parentesis)
# DATA_DIR=data        (carpeta donde se guardan los datos generados)
# LOG_LEVEL=INFO       (DEBUG, INFO, WARNING, ERROR o CRITICAL)
