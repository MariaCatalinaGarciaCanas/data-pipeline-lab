# Entorno virtual de Python (se recrea con uv, no se sube)
.venv/

# Secretos: la API key de EIA irá aquí
.env

# Datos generados por el pipeline (pesados y reproducibles)
data/

# Artefactos que genera dbt al ejecutarse (se recrean)
dbt/target/
dbt/logs/
dbt/dbt_packages/

# Configuración local del editor (VS Code)
.vscode/

# Cachés de Python y herramientas
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
